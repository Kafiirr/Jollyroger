# Copy and use in .env.local (Do not commit — do not enter actual values here)

# Album (SBT) — The UUID of Renaiss's public profile. Retrieves the SBTs this user has “favorited (showcased)” along with their images.
#   * Not secret (public identifier). If missing, the album falls back to placeholder data.
#   * How to find the UUID: Log in to Renaiss → Profile → F12 Network tab → The UUID from the request URL `/v0/users/{uuid}`.
#     (Never copy the request headers or cookies—only the UUID string.)
RENAISS_SHOWCASE_USER=

# Guestbook (Note) — Supabase project. Request the value from a team member.
#   * Since it has the NEXT_PUBLIC_ prefix, it is exposed in the browser (public anon key). Use Supabase RLS policies for security.
#   * Never include the `service_role` key here or on the client side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Card Showcase — Retrieve One Piece card images from apitcg.com. Get a free key at https://apitcg.com/platform.
#   * Server-only secret key — Do not include the NEXT_PUBLIC prefix (do not expose to the browser). Use only in API routes.
APITCG_API_KEY=

# Physical card prices — PokemonPriceTracker (Pokémon-only + PSA/CGC/BGS grades). Free 100 requests per day.
#   * Get a free key at https://www.pokemonpricetracker.com. Server-only (do not expose in the browser).
#   * If missing, fallback in the following order: pokemontcg.io (raw) → snapshot. This API does not cover One Piece (separate source required).
POKEMON_PRICE_TRACKER_KEY=
#   * (Optional) To increase the rate limit on pokemontcg.io. Works even without this.
POKEMONTCG_API_KEY=

# (Optional) For on-chain queries — currently unused. The free tiers of Etherscan and BSCScan do not support BSC queries (paid tier required).
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=

# Reserved/Unused (Currently not in use due to a change in direction)
PSA_API_TOKEN=
PRICE_API_KEY=
ANTHROPIC_API_KEY=

# Cleanverse Ecosystem Sandbox Credentials (CVI, CVA, CCP Protocol)
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=
CLEANVERSE_BASE_URL=

RENAISS_X_API_KEY=
RENAISS_X_API_SECRET=

# Monad Testnet Deployed Smart Contract for One Piece Card Tokenizing RWA Assets
NEXT_PUBLIC_RWA_CARD_CONTRACT_ADDRESS=
MONAD_PRIVATE_KEY=

# Cloudflare R2 Direct Storage (Presigned Client Uploads)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=